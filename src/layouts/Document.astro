---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = '' } = Astro.props;
---
<Base title={title} description={description} canonicalPath={canonicalPath}>
  <slot name="head" slot="head" />

  <main id="main-content">
    <article class="band doc">
      <div class="wrap narrow">
        <a class="home-link" href="/">Creative in the loop</a>
        <slot />
      </div>
    </article>
  </main>
</Base>

<style>
.narrow {
  max-width: 720px;
}

.home-link {
  display: inline-block;
  margin-bottom: 2.5rem;
  font-size: 17px;
  color: var(--muted);
  text-decoration: none;
}

.home-link:hover {
  color: var(--ink);
}

.doc {
  padding-top: max(28px, env(safe-area-inset-top, 0px));
  padding-bottom: clamp(72px, 10vw, 120px);
}

.doc :global(header) {
  margin-bottom: 0.25rem;
}

.doc :global(h1) {
  font-size: clamp(34px, 5vw, 52px);
  line-height: 1.08;
  max-width: 14em;
}

.doc :global(.intro) {
  max-width: none;
}

.doc :global(.draft) {
  margin-top: 1.25rem;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  font-size: 14px;
  line-height: 1.5;
  color: var(--body);
}

.doc :global(h2) {
  max-width: none;
  font-size: clamp(24px, 3vw, 32px);
  line-height: 1.2;
  margin-top: 3.25rem;
  margin-bottom: 0.85rem;
}

.doc :global(h3) {
  font-size: 18px;
  line-height: 1.35;
  margin-top: 1.75rem;
  margin-bottom: 0.4rem;
}

.doc :global(p) {
  margin-bottom: 1rem;
}

.doc :global(ul) {
  margin: 0.25rem 0 1.25rem;
  padding-left: 1.25rem;
}

.doc :global(li) {
  margin-bottom: 0.65rem;
}

.doc :global(li strong) {
  color: var(--ink);
  font-weight: 600;
}

.doc :global(a) {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.doc :global(a:hover) {
  text-decoration-thickness: 2px;
}

.doc .home-link,
.doc .home-link:hover {
  color: var(--muted);
  text-decoration: none;
}

.doc .home-link:hover {
  color: var(--ink);
}

.doc :global(code) {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.9em;
}

.doc :global(.table-scroll) {
  margin: 0.5rem 0 1.25rem;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.doc :global(table) {
  width: 100%;
  border-collapse: collapse;
  font-size: 15px;
  line-height: 1.45;
}

.doc :global(th),
.doc :global(td) {
  text-align: left;
  vertical-align: top;
  padding: 12px 20px 12px 0;
  border-bottom: 1px solid var(--line);
}

.doc :global(th:last-child),
.doc :global(td:last-child) {
  padding-right: 0;
}

.doc :global(thead th) {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}

.doc :global(th[scope="row"]) {
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
  color: var(--ink);
}
</style>
