---
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noIndex?: boolean;
  /** Page brings its own stylesheet, script and footer (the home page). */
  bare?: boolean;
}

const {
  title,
  description,
  canonicalPath = '',
  ogType = 'website',
  ogImage = '/assets/share.png',
  ogImageAlt = 'Creative in the Loop. AI work worth making.',
  noIndex = false,
  bare = false,
} = Astro.props;

const gaId = 'G-FNT41H3HBG';

const siteUrl = 'https://creativeintheloop.com';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const path = Astro.url.pathname;
const onSecurity = path === '/security' || path === '/security/';
const onBlog = path === '/blog' || path === '/blog/';
const onPrivacy = path === '/privacy' || path === '/privacy/';
const onTerms = path === '/terms' || path === '/terms/';
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{noIndex ? (
  <meta name="robots" content="noindex, nofollow">
) : (
  <>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow">
  </>
)}
<link rel="canonical" href={canonicalUrl}>

<meta property="og:type" content={ogType}>
<meta property="og:locale" content="en_GB">
<meta property="og:site_name" content="Creative in the Loop">
<meta property="og:url" content={canonicalUrl}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImageUrl}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageUrl}>
<meta name="twitter:image:alt" content={ogImageAlt}>

{bare ? (
  <meta name="theme-color" content="#04060d">
) : (
  <>
    <meta name="theme-color" content="#f5f6f9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0a0f1b" media="(prefers-color-scheme: dark)">
  </>
)}

<slot name="head" />

<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-icon.png">
{!bare && <link rel="stylesheet" href="/styles.css?v=7">}
</head>
<body>

<a class="skip-link" href="#main-content">Skip to main content</a>

<slot />

{!bare && (
<footer>
  <div class="wrap">
    <div class="footer-row">
      <span>&copy; 2026 Creative in the Loop</span>
      <nav aria-label="Footer">
        <a href="/blog/" aria-current={onBlog ? 'page' : undefined}>Blog</a>
        <a href="/security/" aria-current={onSecurity ? 'page' : undefined}>Data and security</a>
        <a href="/privacy/" aria-current={onPrivacy ? 'page' : undefined}>Privacy</a>
        <a href="/terms/" aria-current={onTerms ? 'page' : undefined}>Terms</a>
        <button type="button" onclick="openCookieSettings()">Cookies</button>
      </nav>
    </div>
    <p class="footer-legal">Creative in the Loop is run by Salo Creative Ltd, registered in England and Wales, company number 11825337. Registered office: 57 Worgret Road, Wareham, Dorset, BH20 4PH.</p>
  </div>
</footer>
)}

{!bare && <script src="/main.js" defer></script>}
<CookieConsent gaId={gaId} />
</body>
</html>
