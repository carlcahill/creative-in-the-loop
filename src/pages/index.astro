---
import Base from '../layouts/Base.astro';

const title = 'Creative in the Loop';
const description = 'Your brand\'s creative brain, inside the AI your team already uses. So everything it makes looks, sounds and thinks like you.';
const signupUrl = 'https://app.creativeintheloop.com/signup';
---
<Base title={title} description={description} canonicalPath="/">
  <Fragment slot="head">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://creativeintheloop.com/#website",
      "url": "https://creativeintheloop.com/",
      "name": "Creative in the Loop",
      "description": "Your brand's creative brain, inside the AI your team already uses. So everything it makes looks, sounds and thinks like you.",
      "inLanguage": "en-GB",
      "publisher": { "@id": "https://creativeintheloop.com/#org" }
    },
    {
      "@type": "Organization",
      "@id": "https://creativeintheloop.com/#org",
      "name": "Creative in the Loop",
      "url": "https://creativeintheloop.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://creativeintheloop.com/assets/apple-touch-icon.png"
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Salo",
        "url": "https://salo.uk/"
      },
      "sameAs": ["https://salo.uk/"]
    },
    {
      "@type": "WebPage",
      "@id": "https://creativeintheloop.com/#webpage",
      "url": "https://creativeintheloop.com/",
      "name": "Creative in the Loop",
      "description": "Your brand's creative brain, inside the AI your team already uses. So everything it makes looks, sounds and thinks like you.",
      "isPartOf": { "@id": "https://creativeintheloop.com/#website" },
      "about": { "@id": "https://creativeintheloop.com/#org" },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "https://creativeintheloop.com/assets/share.png"
      }
    }
  ]
}
</script>
  </Fragment>

<header class="hero" id="top">
  <canvas id="bg" aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="topbar">
      <a class="wordmark" href="#top">Creative in the loop</a>
      <a class="signin" href="https://app.creativeintheloop.com/login">Sign in</a>
    </div>
    <div class="hero-body">
      <h1 class="display-hero"><span class="line">AI work worth making.</span></h1>
      <p class="lede reveal">Your brand&rsquo;s creative brain, inside the AI your team already uses. So everything it makes looks, sounds and thinks like you.</p>
      <div class="access reveal">
        <a class="access-btn" href={signupUrl}>See your brand&rsquo;s score</a>
        <p>Free, no card.</p>
      </div>
      <p class="hero-note reveal">Works with Claude today. ChatGPT and Copilot soon.</p>
    </div>
  </div>
</header>

<main id="main-content">
  <section class="band">
    <div class="wrap split">
      <div>
        <div class="eyebrow reveal">The gap</div>
        <h2 class="display-section">Your guidelines live in a PDF in a shared drive. Your team&rsquo;s AI has never read it.</h2>
      </div>
      <div>
        <p class="intro intro--flush reveal">So every caption, every brief, every quick &ldquo;does this sound like us?&rdquo; is a guess.</p>
        <p class="intro reveal">The brand doesn&rsquo;t break in one big mistake. It drifts, in a hundred small ones nobody has time to catch.</p>
      </div>
    </div>
  </section>

  <section class="band" id="score">
    <div class="wrap">
      <div class="eyebrow reveal">The score</div>
      <h2 class="display-section">How much of your brand can your AI actually use?</h2>
      <p class="intro reveal">We asked that about our own brand. The answer was 38%.</p>
      <p class="intro reveal">A score doesn&rsquo;t tell you your brand is bad. It tells you what your AI is missing, and what to fix first.</p>
      <p class="intro reveal">Add your guidelines and get yours, free.</p>
      <div class="access access--light reveal">
        <a class="access-btn" href={signupUrl}>Get your score</a>
        <p>Free, no card.</p>
      </div>
    </div>
  </section>

  <section class="band how">
    <canvas class="stage-bloom" id="stageBloom" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="eyebrow reveal">How it works</div>
      <h2 class="display-section">Three steps. Connected in minutes.</h2>
      <ol class="stages reveal" aria-label="How it works">
        <canvas class="stage-flow" id="stageFlow" aria-hidden="true"></canvas>
        <li class="stage">
          <div class="n" aria-hidden="true">1</div>
          <h3>Add your brand guidelines</h3>
        </li>
        <li class="stage">
          <div class="n" aria-hidden="true">2</div>
          <h3>Connect it to the AI your team already uses</h3>
        </li>
        <li class="stage">
          <div class="n" aria-hidden="true">3</div>
          <h3>Create work that&rsquo;s on brand</h3>
        </li>
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="eyebrow reveal">How it connects</div>
      <h2 class="display-section">Your brand, inside the tools your team already has.</h2>
      <p class="intro reveal">No new tool to learn. Connect the brain once and every answer draws on your positioning, voice, visual rules and the design knowledge behind them.</p>
      <div class="connect-panel reveal" id="connect">
        <canvas id="brainField" aria-hidden="true"></canvas>
        <canvas id="flow" aria-hidden="true"></canvas>
        <div class="connect-grid">
          <div class="brain-slot">
            <div class="brain-orb" id="orb"></div>
            <div class="brain-label"><strong>Creative brain</strong><span>Your brand, structured and scored</span></div>
          </div>
          <div class="llm-card" id="llm" aria-label="Example: Claude drawing on the creative brain">
            <div class="llm-head"><b>Claude</b><span>Brain connected</span></div>
            <div class="llm-you">Write a launch post for our new autumn menu.</div>
            <div class="llm-reply">
              <span>Here&rsquo;s a first draft in your voice.</span>
              <div class="bar bar--full"></div>
              <div class="bar bar--88"></div>
              <div class="bar bar--64"></div>
            </div>
            <div class="drawing">Drawing on</div>
            <div class="chips" id="chips">
              <span class="chip">Positioning</span>
              <span class="chip">Tone of voice</span>
              <span class="chip">Audience</span>
              <span class="chip">Colour</span>
              <span class="chip">House rules</span>
              <span class="chip">Design knowledge</span>
            </div>
          </div>
        </div>
      </div>
      <div class="works reveal">
        <p id="works-label">Works with</p>
        <ul class="llms" aria-labelledby="works-label">
          <li class="llm live"><img src="/assets/logos/claude.svg" alt="Claude"> <em>Available now</em></li>
          <li class="llm"><img src="/assets/logos/chatgpt.svg" alt="ChatGPT"> <em>Coming soon</em></li>
          <li class="llm"><img src="/assets/logos/copilot.svg" alt="Microsoft Copilot"> <em>Coming soon</em></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <div>
        <div class="eyebrow reveal">Judgement</div>
        <h2 class="display-section">Plenty of tools can check a hex code. That&rsquo;s the easy part.</h2>
      </div>
      <p class="intro intro--flush reveal">Creative in the Loop is built and scored by real designers. It tells you why a headline lands or doesn&rsquo;t, catches the small things like line height and headline case, and if you&rsquo;ve broken a rule, it asks whether you meant to before calling it a mistake.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <div>
        <div class="eyebrow reveal">A person when it counts</div>
        <h2 class="display-section">Some calls no brain should make alone.</h2>
      </div>
      <div>
        <p class="intro intro--flush reveal">A positioning decision. A campaign idea. A gap your guidelines never covered.</p>
        <p class="intro reveal">When it hits one of those, it says so, and brings in a creative director. Not on every job. Only when it counts.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="eyebrow reveal">For agencies</div>
      <h2 class="display-section">Looking after more than one brand?</h2>
      <p class="intro reveal">Run a brain for every client from a single account. One place, every brand on brand, whoever&rsquo;s doing the making.</p>
    </div>
  </section>

  <section class="closer" id="join">
    <div class="wrap">
      <h2 class="display-section">See what your AI is missing.</h2>
      <p class="intro reveal">Get your brand&rsquo;s score, free.</p>
      <div class="access access--light reveal">
        <a class="access-btn" href={signupUrl}>Get your score</a>
        <p>Add your guidelines, get your score. No card needed.</p>
      </div>
    </div>
  </section>
</main>
</Base>
