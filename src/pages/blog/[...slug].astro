---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const posts = await getCollection('blog', ({ data }) => {
    return isDev || !data.draft;
  });
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const recentPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const title = `${post.data.title} – Creative in the Loop`;
const description = post.data.description;
const canonicalPath = `/blog/${post.id}/`;
const ogImage = post.data.heroImage || '/assets/share.png';
---
<Base
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImage={ogImage}
>
  <Fragment slot="head">
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `https://creativeintheloop.com${canonicalPath}#article`,
  "url": `https://creativeintheloop.com${canonicalPath}`,
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.publishDate.toISOString(),
  "image": post.data.heroImage ? `https://creativeintheloop.com${post.data.heroImage}` : "https://creativeintheloop.com/assets/share.png",
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "keywords": post.data.tags?.join(', '),
  "inLanguage": "en-GB",
  "isPartOf": { "@id": "https://creativeintheloop.com/blog/#blog" },
  "publisher": { "@id": "https://creativeintheloop.com/#org" }
})} />
  </Fragment>

<main id="main-content">
  <article class="band blog-post">
    <div class="wrap wrap--narrow">
      <a href="/blog/" class="back-link reveal">&larr; All posts</a>
      <header class="post-header reveal">
        <div class="post-meta">
          <time datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('en-GB', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span class="post-author">{post.data.author}</span>
        </div>
        <h1 class="display-section">{post.data.title}</h1>
        <p class="intro">{post.data.description}</p>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        )}
      </header>
      {post.data.heroImage && (
        <img
          src={post.data.heroImage}
          alt=""
          class="post-hero reveal"
          loading="eager"
          decoding="async"
        />
      )}
      <div class="prose reveal">
        <Content />
      </div>
    </div>
  </article>

  {recentPosts.length > 0 && (
    <section class="band recent-posts">
      <div class="wrap">
        <h2 class="recent-title reveal">More articles</h2>
        <ul class="recent-list reveal">
          {recentPosts.map((p) => (
            <li class="recent-item">
              <a href={`/blog/${p.id}/`} class="recent-link">
                <time datetime={p.data.publishDate.toISOString()}>
                  {p.data.publishDate.toLocaleDateString('en-GB', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span class="recent-item-title">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</main>
</Base>

<style>
.wrap--narrow {
  max-width: 720px;
}

.back-link {
  display: inline-block;
  font-size: 0.875rem;
  color: var(--muted);
  text-decoration: none;
  margin-bottom: 2rem;
  transition: color 0.15s;
}

.back-link:hover {
  color: var(--ink);
}

.post-header {
  margin-bottom: 2rem;
}

.post-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: var(--muted);
  margin-bottom: 0.75rem;
}

.post-author::before {
  content: '·';
  margin-right: 0.5rem;
}

.post-header h1 {
  margin-bottom: 1rem;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1rem;
}

.post-tag {
  font-size: 0.8125rem;
  padding: 0.25rem 0.75rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
}

.post-hero {
  width: 100%;
  height: auto;
  border-radius: 12px;
  margin-bottom: 2rem;
}

.prose {
  font-size: 1.0625rem;
  line-height: 1.8;
}

.prose h2 {
  font-size: 1.5rem;
  margin-top: 3rem;
  margin-bottom: 1.25rem;
  line-height: 1.3;
}

.prose h3 {
  font-size: 1.25rem;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
  line-height: 1.3;
}

.prose p {
  margin-bottom: 1.5rem;
}

.prose p + p {
  margin-top: 0;
}

.prose ul,
.prose ol {
  margin-bottom: 1.5rem;
  padding-left: 1.5rem;
}

.prose li {
  margin-bottom: 0.625rem;
}

.prose a {
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.prose a:hover {
  text-decoration-thickness: 2px;
}

.prose blockquote {
  margin: 2rem 0;
  padding: 1.25rem 1.5rem;
  border-left: 3px solid var(--accent);
  background: var(--surface);
  border-radius: 0 8px 8px 0;
  font-style: italic;
}

.prose blockquote p {
  margin-bottom: 0;
}

.prose code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.9em;
  background: var(--surface);
  padding: 0.2em 0.4em;
  border-radius: 4px;
}

.prose pre {
  background: var(--surface);
  padding: 1rem;
  border-radius: 8px;
  overflow-x: auto;
  margin-bottom: 1.25rem;
}

.prose pre code {
  background: none;
  padding: 0;
}

.prose img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  margin: 1.5rem 0;
}

.prose hr {
  border: none;
  border-top: 1px solid var(--line);
  margin: 2.5rem 0;
}

.recent-posts {
  border-top: 1px solid var(--line);
  margin-top: 3rem;
}

.recent-title {
  font-size: 1.25rem;
  margin-bottom: 1.5rem;
}

.recent-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 1rem;
}

.recent-item {
  margin: 0;
}

.recent-link {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1rem;
  background: var(--surface);
  border-radius: 8px;
  text-decoration: none;
  transition: box-shadow 0.15s var(--ease-out), transform 0.15s var(--ease-out);
}

.recent-link:hover {
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  transform: translateY(-1px);
}

.recent-link time {
  font-size: 0.8125rem;
  color: var(--muted);
}

.recent-item-title {
  font-weight: 500;
  color: var(--ink);
}

@media (min-width: 640px) {
  .recent-list {
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>
